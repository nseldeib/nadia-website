# Copy this file to `.env` for local development.
#
# Real secrets belong in `.env.local`, which is gitignored and overrides every
# value here. See DATABASE.md, "Where Credentials Go".

# The site's own SQLite database, holding messages sent through the contact
# form. This must NOT point at `.codeyam/db.sqlite3` — that is the editor's
# internal database, and pointing Prisma at it makes `db push` try to reshape
# the editor's own tables.
DATABASE_URL="file:./dev.db"
