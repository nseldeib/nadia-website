{
  "version": 1,
  "providers": {
    "customerio": {
      "name": "customerio"
    },
    "neon": {
      "name": "Neon"
    }
  },
  "resources": {
    "nadia-db": {
      "name": "nadia-db",
      "providerName": "Neon",
      "serviceId": "postgres"
    },
    "nadia-mail": {
      "name": "nadia-mail",
      "providerName": "customerio",
      "serviceId": "builder:sandbox"
    },
    "nadia-mail-workspace": {
      "name": "nadia-mail-workspace",
      "providerName": "customerio",
      "serviceId": "workspace"
    },
    "nadia-postgres": {
      "name": "nadia-postgres",
      "providerName": "Neon",
      "serviceId": "free"
    }
  },
  "environments": {
    "default": {
      "output": ".env",
      "resources": [
        {
          "resourceName": "nadia-db"
        },
        {
          "resourceName": "nadia-mail"
        },
        {
          "resourceName": "nadia-mail-workspace"
        },
        {
          "resourceName": "nadia-postgres"
        }
      ],
      "variables": [
        {
          "variableName": "customerio-send-token",
          "envKey": "CUSTOMERIO_SEND_TOKEN"
        },
        {
          "variableName": "database-url",
          "envKey": "DATABASE_URL"
        }
      ]
    }
  },
  "variables": {
    "customerio-send-token": {
      "name": "customerio-send-token",
      "backendId": "fprjvar_61VIYj4fVwufi7Snu16Pnn0dH7SQnn1lGyQnu937A5rM"
    },
    "database-url": {
      "name": "database-url",
      "backendId": "fprjvar_61VIY1f6Cjr4FiUkv16Pnn0dH7SQnn1lGyQnu937AAhU"
    }
  }
}
