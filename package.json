{
  "name": "codeyam-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "[ -n \"$VERCEL\" ] || playwright install chromium",
    "setup": "npm install && npm run db:push && npm run db:seed",
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "npx prisma db push && npx prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "posts:backfill": "npx tsx scripts/backfill-posts.ts",
    "db:drop-and-reseed": "npx prisma db push --force-reset && npx prisma generate && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.4.1",
    "dotenv": "^17.2.0",
    "fast-xml-parser": "^5.11.1",
    "next": "^16.1.7",
    "pg": "^8.23.0",
    "prisma": "^7.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
